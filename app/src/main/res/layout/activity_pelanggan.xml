<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.github.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5"
    tools:context=".PelangganActivity"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Kolom Cari Pelanggan -->
    <LinearLayout
        android:id="@+id/search_container_pelanggan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:drawable/editbox_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#78909C" />

        <EditText
            android:id="@+id/et_search_pelanggan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:hint="Cari Pelanggan..."
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#4A4A4A"
            android:textSize="16sp"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- List Data Pelanggan -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pelanggan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/search_container_pelanggan"
        android:layout_above="@+id/fab_add_pelanggan"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Tombol Plus Tambah Pelanggan (Pastel Pink) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_pelanggan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#F8BBD0"
        app:tint="#FFFFFF"
        android:importantForAccessibility="no" />

</RelativeLayout>