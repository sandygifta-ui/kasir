<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    android:backgroundTint="?android:attr/windowBackground"
    tools:ignore="HardcodedText,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#8D7B68"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Karyawan"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jabatan"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmpEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@karyawan.com"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEmpPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08123456789"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 🌟 FIX: minHeight dinaikkan ke 48dp sesuai standar Google Touch Target Size -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusAktif"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:text="Aktif"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#2E7D32"
            app:icon="@android:drawable/checkbox_on_background"
            app:iconTint="#2E7D32"
            app:iconGravity="textStart"
            app:backgroundTint="#E8F5E9"
            app:strokeColor="#4CAF50"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:minHeight="48dp"
            android:padding="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>